<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_common_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="28dp"
    android:paddingEnd="12dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="23sp"
        tools:text="Generating your video" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        tools:layout_height="64dp"
        tools:layout_width="91dp"
        tools:src="@mipmap/ic_generate_result_status0" />

    <com.hjq.shape.layout.ShapeLinearLayout
        android:id="@+id/timeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:shape_radius="10dp"
        app:shape_solidColor="#2BDADADA"
        tools:visibility="visible">

        <TextView
            android:id="@+id/timeMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="Estimated time：" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFF77417"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="10 minutes"
            tools:visibility="visible" />

    </com.hjq.shape.layout.ShapeLinearLayout>

    <TextView
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        tools:text="It will be available in your works once it's done!" />

    <com.hjq.shape.view.ShapeButton
        android:id="@+id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="15dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:shape_radius="20dp"
        app:shape_solidGradientEndColor="#FFFD662E"
        app:shape_solidGradientOrientation="leftToRight"
        app:shape_solidGradientStartColor="#FFFE9233"
        app:shape_solidPressedColor="#FFE85E2A"
        tools:text="Confirm" />

    <TextView
        android:id="@+id/cancelButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:textColor="#FFC1BFBF"
        android:textSize="18sp"
        android:visibility="gone"
        tools:text="Cancel"
        tools:visibility="visible" />

</LinearLayout>
