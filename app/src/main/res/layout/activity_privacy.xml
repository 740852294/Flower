<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@mipmap/pic_privacy"
            app:layout_constraintDimensionRatio="375:656"
            app:layout_constraintTop_toTopOf="parent" />

        <com.hjq.shape.view.ShapeView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@id/ivBg"
            app:layout_constraintDimensionRatio="375:328"
            app:shape_solidGradientEndColor="#FF1F1F1F"
            app:shape_solidGradientOrientation="topToBottom"
            app:shape_solidGradientStartColor="#001F1F1F" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="70dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Terms of Use and Privacy Policy" />

        <TextView
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="80dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/ivBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="By continuing to use the color walkpaper app, you represent that you have read and accept both the Terms of Use and Privacy Policy." />

        <com.hjq.shape.view.ShapeButton
            android:id="@+id/btnAgree"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/btnDisagree"
            app:shape_radius="21dp"
            app:shape_solidGradientEndColor="#FFFD662E"
            app:shape_solidGradientOrientation="leftToRight"
            app:shape_solidGradientStartColor="#FFFE9233"
            tools:text="ACCEPT&amp;CONTINUE" />

        <com.hjq.shape.view.ShapeButton
            android:id="@+id/btnDisagree"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="60dp"
            android:gravity="center"
            android:textColor="#FFD9D9D9"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shape_radius="21dp"
            app:shape_solidColor="#1aFFFFFF"
            app:shape_strokeColor="#1aFFFFFF"
            app:shape_strokeSize="1dp"
            tools:text="DISGREE" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>