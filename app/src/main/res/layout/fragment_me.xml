<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@mipmap/bg_me" />

    <LinearLayout
        android:id="@+id/llContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="15dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settingBtn"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_me_setting"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.hjq.shape.view.ShapeView
                android:id="@+id/redDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/settingBtn"
                app:layout_constraintTop_toTopOf="@id/settingBtn"
                app:shape_radius="4dp"
                app:shape_solidColor="#D9001B"
                tools:visibility="visible" />

            <com.hjq.shape.layout.ShapeLinearLayout
                android:id="@+id/llMoney"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="7dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="7dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/settingBtn"
                app:layout_constraintEnd_toStartOf="@+id/settingBtn"
                app:layout_constraintTop_toTopOf="@+id/settingBtn"
                app:shape_radius="16dp"
                app:shape_solidColor="#30FFFFFF"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_me_money" />

                <TextView
                    android:id="@+id/tvMoney"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="34dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </com.hjq.shape.layout.ShapeLinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingHorizontal="16dp">

            <com.hjq.shape.view.ShapeImageView
                android:id="@+id/ivAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="2dp"
                android:src="@mipmap/ic_default_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shape_radius="32dp"
                app:shape_strokeColor="@color/white"
                app:shape_strokeSize="2dp" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                app:layout_constraintEnd_toStartOf="@id/ivEdit"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivAvatar"
                tools:text="XXXXXXXXXXXXXX" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivEdit"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="25dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_me_edit"
                app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                app:layout_constraintEnd_toStartOf="@id/ivAvatar"
                app:layout_constraintStart_toEndOf="@id/tvName"
                app:layout_constraintTop_toTopOf="@id/ivAvatar" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivVipLabel"
                android:layout_width="65dp"
                android:layout_height="20dp"
                android:layout_marginBottom="-4dp"
                android:src="@mipmap/ic_me_vip"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                app:layout_constraintEnd_toEndOf="@id/ivAvatar"
                app:layout_constraintStart_toStartOf="@id/ivAvatar"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clVip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivVipBg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="25dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@mipmap/ic_me_vip_bg"
                app:layout_constraintDimensionRatio="344:80"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="5dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/ivVipBg"
                app:layout_constraintEnd_toStartOf="@+id/ivVipStar"
                app:layout_constraintStart_toStartOf="@id/ivVipBg"
                app:layout_constraintTop_toTopOf="@id/ivVipBg">

                <TextView
                    android:id="@+id/vipTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="AI Video PRO" />

                <TextView
                    android:id="@+id/vipSubtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="Upgrading unlock more functions ddd dddd" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivVipStar"
                android:layout_width="115dp"
                android:layout_height="93dp"
                android:layout_marginEnd="29dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_me_vip_star"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.hjq.shape.view.ShapeButton
                android:id="@+id/btnVip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#333333"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/ivVipBg"
                app:layout_constraintEnd_toEndOf="@id/ivVipBg"
                app:shape_radiusInBottomEnd="10dp"
                app:shape_radiusInBottomStart="5dp"
                app:shape_radiusInTopStart="10dp"
                app:shape_solidGradientEndColor="#FFFFAE2C"
                app:shape_solidGradientOrientation="startToEnd"
                app:shape_solidGradientStartColor="#FFFFE9CF"
                tools:text="upgrade" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.hjq.shape.layout.ShapeFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="32dp"
            android:paddingHorizontal="15dp"
            android:paddingVertical="13dp"
            app:shape_radiusInTopEnd="15dp"
            app:shape_radiusInTopStart="15dp"
            app:shape_solidGradientCenterColor="#FF1D2025"
            app:shape_solidGradientCenterY="0.05"
            app:shape_solidGradientEndColor="#FF1D2025"
            app:shape_solidGradientOrientation="topToBottom"
            app:shape_solidGradientStartColor="#FF3A332B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/worksLabel"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="My Creations" />

                    <com.hjq.shape.view.ShapeButton
                        android:id="@+id/btnDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:shape_radius="15dp"
                        app:shape_strokeColor="@color/white"
                        app:shape_strokeSize="1dp"
                        tools:text="Delete"
                        tools:visibility="visible" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvOverTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="The number of your works has exceeded 10. The excess will be automatically deleted after 3 days. "
                    tools:visibility="visible" />

                <com.hjq.shape.layout.ShapeRelativeLayout
                    android:id="@+id/rlWorkAdd"
                    android:layout_width="152dp"
                    android:layout_height="216dp"
                    android:layout_marginTop="20dp"
                    app:shape_radius="10dp"
                    app:shape_solidColor="#FF2E2E2E">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="33dp"
                        android:layout_height="33dp"
                        android:layout_centerInParent="true"
                        android:src="@mipmap/ic_me_work_add" />

                </com.hjq.shape.layout.ShapeRelativeLayout>

            </LinearLayout>
        </com.hjq.shape.layout.ShapeFrameLayout>

    </LinearLayout>

</FrameLayout>