<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="DashedLineView">
        <attr name="dlv_orientation" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
        </attr>
        <attr name="dlv_dashLength" format="dimension" />
        <attr name="dlv_dashGap" format="dimension" />
        <attr name="dlv_lineWidth" format="dimension" />
        <attr name="dlv_lineColor" format="color" />
    </declare-styleable>

    <declare-styleable name="RoundCornerImageView">
        <attr name="rciv_cornerRadius" format="dimension" />
        <attr name="rciv_cornerTopLeftRadius" format="dimension" />
        <attr name="rciv_cornerTopRightRadius" format="dimension" />
        <attr name="rciv_cornerBottomRightRadius" format="dimension" />
        <attr name="rciv_cornerBottomLeftRadius" format="dimension" />
        <attr name="rciv_borderWidth" format="dimension" />
        <attr name="rciv_borderColor" format="color" />
        <attr name="rciv_borderGradientStartColor" format="color" />
        <attr name="rciv_borderGradientEndColor" format="color" />
        <attr name="rciv_borderGradientOrientation" format="enum">
            <enum name="leftToRight" value="0" />
            <enum name="topToBottom" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="DrawableBlurImageView">
        <attr name="dbiv_cornerRadius" format="dimension" />
    </declare-styleable>
</resources>
