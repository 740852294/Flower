<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="DashedLineView">
        <attr name="dlv_orientation" format="enum">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
        </attr>
        <attr name="dlv_dashLength" format="dimension" />
        <attr name="dlv_dashGap" format="dimension" />
        <attr name="dlv_lineWidth" format="dimension" />
        <attr name="dlv_lineColor" format="color" />
    </declare-styleable>
</resources>
